            <span class="tg-po-check" aria-label="Ready">\u2713</span>
          </h2>
          <p class="tg-po-support">Paste at checkout</p>
          <div class="tg-po-actions">
            <p class="tg-po-code" aria-live="polite">
              <span class="tg-po-code-text"></span>
              ${ke}
            </p>
            <button type="button" class="tg-po-copy">Copy</button>
          </div>
          <p class="tg-po-hint">Tap Copy to save your code</p>
          ${u}
        </div>
        <div class="tg-po-face tg-po-back" aria-label="Powered by Togethr" aria-live="polite">
          <p class="tg-po-copied"><span class="tg-po-check" aria-hidden="true">\u2713</span> CODE COPIED</p>
          <p class="tg-po-powered">POWERED BY</p>
          <div class="tg-po-logo-stage">
            <img class="tg-po-logo" src="${p.replace(/"/g,"&quot;")}" alt="Togethr" width="205" height="72" decoding="async" />
          </div>
          <p class="tg-po-tagline">Great rewards bring brands togethr.</p>
          <span class="tg-po-spectrum" aria-hidden="true"></span>
        </div>
      </div>
    </div>
