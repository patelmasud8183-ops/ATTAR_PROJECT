if(typeof executedSnowfallEffectPlus==='undefined'){var hura_show_effect=false;if(window.meta?.page?.pageType==='home'){hura_show_effect=true;}
var isHMAKMobile=navigator.userAgent.match(/(iPhone|iPod|iPad|Android|webOS|BlackBerry|IEMobile|Opera Mini)/i);if(hura_show_effect){function huraMovingClouds(opacity,direction){let cloud_css='';if(direction==1){cloud_css='<style>@keyframes huraCloudAnimation{from{-webkit-transform:translateX(100%);transform:translateX(100%)}to{-webkit-transform:translateX(-100%);transform:translateX(-100%)}}#hura-clouds{width:100%;height:100%;overflow:hidden;position:fixed;z-index:9999;left:0;right:0;bottom:0;pointer-events:none}#hura-clouds img{width:100%;left:0;top:0;position:absolute;opacity:'+opacity+'}#hura-clouds img.hura-cloud1{-webkit-animation:huraCloudAnimation 25s infinite linear;animation:huraCloudAnimation 25s infinite linear}#hura-clouds img.hura-cloud2{-webkit-animation:huraCloudAnimation 35s infinite linear;animation:huraCloudAnimation 35s infinite linear}#hura-clouds img.hura-cloud3{-webkit-animation:huraCloudAnimation 45s infinite linear;animation:huraCloudAnimation 45s infinite linear;}#hura-clouds img.hura-cloud4{-webkit-animation:huraCloudAnimation 55s infinite linear;animation:huraCloudAnimation 55s infinite linear;}</style>';}else{cloud_css='<style>@keyframes huraCloudAnimation{from{-webkit-transform:translateX(-100%);transform:translateX(-100%)}to{-webkit-transform:translateX(100%);transform:translateX(100%)}}#hura-clouds{width:100%;height:100%;overflow:hidden;position:fixed;z-index:9999;left:0;right:0;bottom:0;pointer-events:none}#hura-clouds img{width:100%;left:0;top:0;position:absolute;opacity:'+opacity+'}#hura-clouds img.hura-cloud1{-webkit-animation:huraCloudAnimation 25s infinite linear;animation:huraCloudAnimation 25s infinite linear}#hura-clouds img.hura-cloud2{-webkit-animation:huraCloudAnimation 35s infinite linear;animation:huraCloudAnimation 35s infinite linear}#hura-clouds img.hura-cloud3{-webkit-animation:huraCloudAnimation 45s infinite linear;animation:huraCloudAnimation 45s infinite linear;}#hura-clouds img.hura-cloud4{-webkit-animation:huraCloudAnimation 55s infinite linear;animation:huraCloudAnimation 55s infinite linear;}</style>';}
let cloud_html='<div id="hura-clouds" class="hura-effect-wrapper">';for(var i=1;i<5;i++){cloud_html+='<img class="hura-cloud'+i+'" src="//cdn.shopify.com/s/files/1/0382/4185/files/cloud-'+i+'.png?v=1" />';}
cloud_html+='</div>';document.body.insertAdjacentHTML('beforeend',cloud_css+cloud_html);}huraMovingClouds(0.5,1);}
setTimeout(function(){var hura_selectors='.shopifytipsSnowEffect, #AKSnowfallEffect2, #AKSFallingHearts, #HMAKFallingFlowersWrapper, #AKSolutionsFireWorkEffect, .hearts, .halloweenBat, .huraapps-confetti-land, .hura-effect-wrapper';document.querySelectorAll(hura_selectors).forEach(function(element){element.remove();});var huraappendCSS='<style>.sakura,canvas.sparticles{display:none!important}</style>';document.head.insertAdjacentHTML('beforeend',huraappendCSS);},10000);var executedSnowfallEffectPlus=1;}