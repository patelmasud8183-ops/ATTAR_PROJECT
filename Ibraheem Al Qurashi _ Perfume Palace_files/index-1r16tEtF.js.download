        // Mark this add as bot-originated for the web pixel, which fires
        // product_added_to_cart on the add itself — before /cart/update.js
        // below has had a chance to set any cart attributes. Short-lived so a
        // later organic add on the same page is not mis-tagged.
        try {
          document.cookie = 'vf-atc-source=bot; path=/; max-age=10; SameSite=Lax';
        } catch (e) {}
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: ${s},
            quantity: ${o},
            note: '${c}'
          }),
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        })
        .then(data => {
          console.log('Success:', data);
          // After successful add to cart, update cart attributes
          return fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              attributes: {
                'verifast_source': 'chat_bot',
                'verifast_session': '${t.customerId}',
                'verifast_timestamp': '${_}',
                ${T}
                'utm_medium': '${l}',
                'utm_term': '${g}'
              }
            })
          })
          .then(() => {
            ${O[n]}
          });
        })
        .catch(error => {
          console.error('Error:', error);
          return { success: false, error: error.message };
        });
      `},"*"),!0}catch(r){return console.error("Error handling Shopify cart:",r),!1}},ca=(e,t,n)=>{try{const r=e.match(/\/cart\/(\d+):(\d+)/);if(!r){console.error("Invalid cart URL format");return}const[,s,o]=r,c=new URL(e).searchParams.get("note")||"came-from-verifast",_=new Date().toISOString(),f="verifast",l="chatbot",g=t.customerId,T=t.botConfig.flags.removeUtmSource?"":`'utm_source': '${f}',`,O={SHOP_FLO:"window.handleFloCartBtn();",GO_KWICK:"window.triggerGokwikCustomCheckout();",SHIP_ROCKET:"window.shiprocketCheckoutBuyCartHandler();",DEFAULT:"let cartDrawer = document.querySelector('cart-drawer'); if(!cartDrawer) cartDrawer = document.querySelector('new-cart-drawer'); if (cartDrawer) cartDrawer.open();",REFRESH:"window.location.reload();",TECTONIC:"window.location.href = '/cart';"};return window.parent.postMessage({type:"execute-function",functionBody:`
        // Mark this add as bot-originated for the web pixel, which fires
        // product_added_to_cart on the add itself — before /cart/update.js
        // below has had a chance to set any cart attributes. Short-lived so a
        // later organic add on the same page is not mis-tagged.
        try {
          document.cookie = 'vf-atc-source=bot; path=/; max-age=10; SameSite=Lax';
        } catch (e) {}
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            items: [{
              id: ${s},
              quantity: ${o}
            }]
          }),
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        })
        .then(data => {
          console.log('Success:', data);
          // After successful add to cart, update cart attributes
          return fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              attributes: {
                'verifast_source': 'chat_bot',
                'verifast_session': '${t.customerId}',
                'verifast_timestamp': '${_}',
                ${T}
                'utm_medium': '${l}',
                'utm_term': '${g}',
                'note': '${c}'
              }
            })
          })
          .then(() => {
            ${O[n]||""}
          });
        })
        .catch(error => {
